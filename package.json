{
  "name": "apollo-flight",
  "version": "0.0.6",
  "description": "Modern flight tracking, telemetry analysis, and IFR companion for Microsoft Flight Simulator.",
  "author": "Jürgen Jacobsen",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "tsc && vite build --config vite.config.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run --config vitest.config.mjs --configLoader native",
    "test:watch": "vitest --config vitest.config.mjs --configLoader native",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:sync": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.67.1",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "clsx": "^2.1.1",
    "geist": "^1.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.2.4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.2.0",
    "vitest": "^5.1.1"
  }
}
